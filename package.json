{
  "name": "mini-cut",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,server \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "npm run dev -w @mini-cut/web",
    "dev:server": "npm run dev -w @mini-cut/server",
    "build": "npm run build -w @mini-cut/web",
    "lint": "oxlint",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "prettier": "^3",
    "typescript": "~7.0.2"
  }
}
